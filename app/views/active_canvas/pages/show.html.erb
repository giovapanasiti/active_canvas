<%= render "active_canvas/pages/head",
      title: @page.meta_title.presence || @page.title,
      description: @page.meta_description,
      robots: @page.meta_robots,
      og_title: @page.og_title,
      og_description: @page.og_description,
      og_image: @page.og_image,
      twitter_card: @page.twitter_card,
      twitter_title: @page.twitter_title,
      twitter_description: @page.twitter_description,
      twitter_image: @page.twitter_image,
      canonical_url: @page.canonical_url,
      structured_data: @page.structured_data %>

<%= render "active_canvas/pages/body",
      page: @page,
      form_feedback: { submitted: params[:ac_submitted], error: params[:ac_form_error], form_key: params[:ac_form] },
      form_action: public_form_submissions_path %>
