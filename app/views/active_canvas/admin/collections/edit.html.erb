<% content_for :page_title, @collection.name %>

<% index_template_page = @collection.has_pages? ? @collection.template_pages.find_by(collection_role: "index") : nil %>
<% show_template_page = @collection.has_pages? ? @collection.template_pages.find_by(collection_role: "show") : nil %>

<div class="page-header">
  <h2>Edit collection</h2>
  <%= link_to "Manage items", admin_collection_items_path(@collection), class: "btn btn-secondary" %>
  <% if index_template_page %>
    <%= link_to "Design index page", editor_admin_page_path(index_template_page), class: "btn btn-secondary" %>
  <% end %>
  <% if show_template_page %>
    <%= link_to "Design item page", editor_admin_page_path(show_template_page), class: "btn btn-secondary" %>
  <% end %>
</div>

<div class="card" style="padding:1.5rem;">
  <%= render "form" %>
</div>
