<div class="form-group" id="ac-field-builder">
  <label>Fields</label>
  <p><small>Define the typed columns of this collection. Field IDs are generated from labels and never change once created.</small></p>

  <script type="application/json" id="ac-fields-data"><%= raw json_escape(@collection.fields_json) %></script>
  <ul id="ac-fields-list" style="list-style:none;padding:0;margin:0;"></ul>
  <button type="button" id="ac-add-field-btn" class="btn btn-sm btn-secondary">Add field</button>

  <%= form.hidden_field :fields_json, id: "ac-fields-json" %>

  <template id="ac-field-row-template">
    <li class="ac-field-row card" style="display:flex;gap:.5rem;align-items:center;padding:.5rem;margin-bottom:.5rem;">
      <input type="hidden" data-field="id">
      <span style="flex:2;display:flex;flex-direction:column;gap:2px;">
        <input type="text" data-field="label" class="form-control" placeholder="Label">
        <code data-field-id-display class="ac-field-id" style="font-size:.7rem;opacity:.7;" title="Use this in the page: {{ item.<id> }}"></code>
      </span>
      <select data-field="type" class="form-control" style="flex:1;">
        <option value="text">Text</option>
        <option value="textarea">Textarea</option>
        <option value="rich_text">Rich text (HTML)</option>
        <option value="number">Number</option>
        <option value="boolean">Boolean</option>
        <option value="date">Date</option>
        <option value="select">Select</option>
        <option value="media">Media</option>
      </select>
      <input type="text" data-field="options" class="form-control ac-field-options" placeholder="a, b, c" style="flex:1;" hidden>
      <label style="white-space:nowrap;"><input type="checkbox" data-field="required"> Required</label>
      <button type="button" data-move="up" class="btn btn-sm btn-secondary" title="Move up">&uarr;</button>
      <button type="button" data-move="down" class="btn btn-sm btn-secondary" title="Move down">&darr;</button>
      <button type="button" data-remove class="btn btn-sm btn-danger" title="Remove">&times;</button>
    </li>
  </template>
</div>
