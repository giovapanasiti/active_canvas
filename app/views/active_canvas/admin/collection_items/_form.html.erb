<% form_url = @item.persisted? ? admin_collection_item_path(@collection, @item) : admin_collection_items_path(@collection) %>
<%= form_with model: @item, url: form_url, method: (@item.persisted? ? :patch : :post) do |form| %>
  <% if @item.errors.any? %>
    <div class="error-messages">
      <ul>
        <% @item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :slug, "Item slug (optional)" %>
    <%= form.text_field :slug, class: "form-control" %>
  </div>

  <% @collection.fields.each do |field| %>
    <%= render "field_input", field: field, value: (@item.draft_data || {})[field["id"]] %>
  <% end %>

  <div class="form-actions">
    <%= form.submit "Save draft", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_collection_items_path(@collection), class: "btn btn-secondary" %>
  </div>
<% end %>

<%= javascript_include_tag "active_canvas/admin/media_select_preview" %>
