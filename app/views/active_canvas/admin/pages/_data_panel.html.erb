<%# app/views/active_canvas/admin/pages/_data_panel.html.erb %>
<div id="data-panel-container" class="data-panel" style="display: none;"
     data-page-id="<%= @page.id %>"
     data-template-enabled="<%= @page.template_enabled? %>"
     data-data-sources-url="<%= data_sources_admin_pages_path(format: :json) %>"
     data-render-preview-url="<%= render_preview_admin_page_path(@page) %>">

  <div class="data-panel-header">
    <span class="data-panel-title">Bindings</span>
    <button type="button" id="ac-add-binding-btn" class="data-panel-add-btn" title="Add a new binding">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Add
    </button>
  </div>

  <ul id="ac-bindings-list" class="data-panel-list" data-empty="true"></ul>

  <div class="data-panel-empty" id="ac-bindings-empty">
    <div class="data-panel-empty-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <ellipse cx="12" cy="5" rx="9" ry="3"/>
        <path d="M3 5v14a9 3 0 0 0 18 0V5"/>
        <path d="M3 12a9 3 0 0 0 18 0"/>
      </svg>
    </div>
    <h3>No bindings yet</h3>
    <p>Connect a data source to use <code>&#123;&#123; variables &#125;&#125;</code> in your page.</p>
    <button type="button" id="ac-empty-add-btn" class="data-panel-empty-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Add binding
    </button>
  </div>

  <p class="data-panel-help">Tip: click a chip to copy the snippet to your clipboard.</p>

  <template id="ac-binding-form-template">
    <form id="ac-binding-form" class="data-panel-add-card">
      <div class="data-panel-add-card-header">
        <span class="data-panel-add-card-title">New binding</span>
        <button type="button" id="ac-binding-cancel" class="data-panel-add-card-close" title="Cancel">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <label class="data-panel-field">
        <span class="data-panel-field-label">Name</span>
        <input type="text" name="name" required autocomplete="off" placeholder="articles">
      </label>
      <label class="data-panel-field">
        <span class="data-panel-field-label">Source</span>
        <select name="source"></select>
      </label>
      <div id="ac-binding-params" class="data-panel-add-card-params"></div>
      <div class="data-panel-add-card-actions">
        <button type="button" class="data-panel-btn data-panel-btn-ghost" data-cancel>Cancel</button>
        <button type="submit" class="data-panel-btn data-panel-btn-primary">Save binding</button>
      </div>
    </form>
  </template>
</div>
